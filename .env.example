# Local Next.js server proxy. Set before next dev or next build.
QUANTUM_API_URL=http://127.0.0.1:8000
# Python process reads this environment setting; it does not load .env.local.
SIMULATION_ENABLED=true
# Browser API base. Same origin in local proxy mode and on Vercel.
NEXT_PUBLIC_API_BASE_URL=/api
# On Vercel leave QUANTUM_API_URL unset: vercel.json selects the Python function.
# api/index.py enables portable state pages and one-thread numeric libraries.
# Vercel build setting: honor packageManager pnpm@11.25.0 (no paid feature).
ENABLE_EXPERIMENTAL_COREPACK=1
